process {
    withName: "GET_PROTEOME|ADD_DECOYS_CONTAMS|FRAGPIPE" {
        container = "docker.io/fcyucn/fragpipe:24.0"
    }

    withName: "RAWBEANS_QC_ALL" {
        container = "quay.io/torres-alexis/rawbeans:1.6.4"
    }

    withName: "GET_ACCESSIONS|FETCH_ISA|FILTER_TECH_REPS|DROP_DECOYS_CONTAMS|FRAGPIPE_METADATA_SETUP|CLEAN_FRAGPIPE_TABLES|ZIP_FRAGPIPE_OUTPUTS|ISA_TO_RUNSHEET|FRAGPIPE_CONFIG_SETUP|SOFTWARE_VERSIONS|GENERATE_MD5SUMS|VALIDATE_PROCESSING|GENERATE_PROCESSED_PROTOCOL|PARSE_ANNOTATIONS_TABLE|COPY_INPUT|FETCH_INPUT|CLEAN_PATHS|VV_STEP|VV_CONCAT_FILTER|FETCH_REFERENCE_PROTEOME" {
        container = "quay.io/nasa_genelab/dp_tools:1.3.8-slim"
    }

    withName: "PACKAGE_PROCESSING_INFO" {
        container = "quay.io/nasa_genelab/zip:3.0"
    }

    withName: "PMULTIQC" {
        container = "quay.io/biocontainers/pmultiqc:0.0.48--pyhdfd78af_0"
    }

    withName: "FRAGPIPEANALYSTR" {
        container = "quay.io/torres-alexis/fpar:1.1.1"
    }

    withName: "MSSTATS" {
        container = "quay.io/biocontainers/bioconductor-msstats:4.18.1--r45ha27e39d_0"
    }

    withName: "MSSTATSTMT" {
        container = "quay.io/biocontainers/bioconductor-msstatstmt:2.18.0--r45hdfd78af_0"
    }
}
