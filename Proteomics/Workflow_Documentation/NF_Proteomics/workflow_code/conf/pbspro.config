/*
    Fetch jobs use --pbs_internet_queue when set.
*/

params {
    pbs_queue = 'normal'
    pbs_model = ''
    pbs_internet_queue = ''
}

process {
    executor = 'pbspro'
    cache = 'lenient'
    queue = {
        def s = (params.pbs_queue instanceof CharSequence) ? params.pbs_queue.toString().trim() : ""
        if ( s in ['true', 'false'] ) s = ""
        s ?: 'normal'
    }
    clusterOptions = {
        def raw = params.pbs_model
        def s = (raw instanceof CharSequence) ? raw.toString().trim() : ""
        if ( s in ['true', 'false'] ) s = ""
        def model = s ? ":model=${s}" : ""
        def mem_gb = task.memory.toGiga()
        if ( mem_gb < 1 ) mem_gb = 1
        "-l select=1:ncpus=${task.cpus}:mem=${mem_gb}GB${model}"
    }
    withName: 'GET_ACCESSIONS|FETCH_ISA|COPY_INPUT|FETCH_INPUT|GET_PROTEOME|FETCH_REFERENCE_PROTEOME' {
        queue = {
            def iq = (params.pbs_internet_queue instanceof CharSequence) ? params.pbs_internet_queue.toString().trim() : ""
            if ( iq in ['true', 'false'] ) iq = ""
            def q = (params.pbs_queue instanceof CharSequence) ? params.pbs_queue.toString().trim() : ""
            if ( q in ['true', 'false'] ) q = ""
            iq ?: q ?: 'normal'
        }
    }
}

executor {
    queueSize = 24
    pollInterval = '2 min'
    queueStatInterval = '5 min'
    submitRateLimit = '10/1min'
    exitReadTimeout = '15 min'
}
