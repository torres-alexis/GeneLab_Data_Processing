/*
    Shared process cpus/memory/time. Executor settings live in
    slurm.config / pbspro.config / local.config.

    Retries: OOM (130..145 + 104) and Singularity 255.
    memory = { base + step * (task.attempt - 1) }
*/

process {
    cpus   = 1
    memory = 2.GB
    time   = {
        def s = (params.walltime instanceof CharSequence) ? params.walltime.toString().trim() : ""
        if( !s || s in ['true', 'false'] ) return 2.hour
        return params.walltime
    }

    errorStrategy = {
        if( task.exitStatus == 255 ) return 'retry'
        task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish'
    }
    maxRetries    = 1
    maxErrors     = '-1'

    withName: 'GENERATE_MD5SUMS' {
        cpus = 1
        memory = { 8.GB + 8.GB * (task.attempt - 1) }
        time = 8.hour
    }

    withName: 'COPY_INPUT|FETCH_INPUT|FETCH_ISA|FETCH_REFERENCE_PROTEOME|GET_PROTEOME' {
        time = 8.hour
    }

    withName: 'RAWBEANS_QC_ALL' {
        cpus = 8
        memory = 64.GB
        time = 24.hour
    }

    withName: 'MSSTATS|MSSTATSTMT' {
        cpus = 2
        memory = 8.GB
        time = 8.hour
    }

    withName: 'FRAGPIPEANALYSTR' {
        cpus = { 4 + (task.attempt - 1) * 4 }
        memory = { 16.GB + (task.attempt - 1) * 16.GB }
        maxRetries = 2
        time = 24.hour
    }

    withName: 'PMULTIQC' {
        cpus = 1
        memory = 4.GB
        time = 8.hour
    }

    withName: 'FRAGPIPE' {
        cpus = { 16 + (task.attempt - 1) * 2 }
        memory = { 64.GB + (task.attempt - 1) * 64.GB }
        maxRetries = 3
        errorStrategy = 'retry'
        stageInMode = 'copy'
        time = 72.hour
    }
}
